{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
  "alias": "AnnouncementsCarouselWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab"],
  "supportsThemeVariants": true,
  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
      "group": { "default": "Communication" },
      "title": { "default": "Announcements Carousel" },
      "description": { "default": "Beautiful announcements and celebrations carousel with automatic list provisioning" },
      "officeFabricIconFontName": "Megaphone",
      "properties": {
        "listName": "Announcements Carousel",
        "rotationInterval": 10,
        "showTitle": true,
        "showDescription": true,
        "titleFontSize": 32,
        "descriptionFontSize": 16,
        "backgroundColor": "#ffffff",
        "textColor": "#333333",
        "height": 500,
        "enableTransitions": true,
        "transitionEffect": "fade",
        "showNavigationDots": true,
        "showNavigationArrows": true,
        "autoPlay": true,
        "celebrationIconSize": 60,
        "showCelebrationIcon": true,
        "borderRadius": 8,
        "showShadow": true,
        "overlayOpacity": 30
      }
    }
  ]
}
